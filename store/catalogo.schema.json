{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalogo da Loja Free My TV",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated", "categories", "apps"],
  "properties": {
    "schema": { "const": 1 },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "order"],
        "properties": {
          "id": { "enum": ["destaques", "iptv", "video-musica"] },
          "name": { "$ref": "#/$defs/text" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url", "icon", "color", "category", "desc", "site", "paid", "needs", "http", "featured", "order"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 24 },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
          "icon": { "type": "string", "pattern": "^icons/[a-z0-9-]+\\.png$" },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "category": { "enum": ["iptv", "video-musica"] },
          "desc": { "$ref": "#/$defs/text" },
          "site": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "paid": { "enum": ["free", "freemium", "paid"] },
          "needs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "http": { "type": "boolean" },
          "featured": { "type": "boolean" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt", "en"],
      "properties": {
        "pt": { "type": "string", "minLength": 1, "maxLength": 140 },
        "en": { "type": "string", "minLength": 1, "maxLength": 140 }
      }
    }
  }
}
